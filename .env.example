# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and paste your keys in.
#   cp .env.example .env
# NEVER commit your real .env -- it's already in .gitignore.
# ---------------------------------------------------------------------------

# 1) Groq API key  (REQUIRED -- the LLM every agent's brain runs on)
#    Free, no card:  https://console.groq.com/keys
GROQ_API_KEY=

# 2) RapidAPI key  (REQUIRED for the Airbnb agent only)
#    Free tier: sign up at https://rapidapi.com then SUBSCRIBE to
#    "Airbnb13" by 3b-data:
#    https://rapidapi.com/3b-data-3b-data-default/api/airbnb13
#    (Leave blank if you don't plan to run the Airbnb agent -- the other
#     three agents work without it. The Flight and Hotel agents call remote
#     MCP servers that hold their OWN keys, so you need nothing for those.)
RAPIDAPI_KEY=

# 3) Agent API key  (REQUIRED -- a secret YOU invent, not from any service)
#    Every agent requires this exact string in the `X-API-Key` header on
#    every request (except fetching the public Agent Card). Generate one:
#      openssl rand -hex 32
#    ...and paste the result below. Any random string works.
AGENT_API_KEY=

# The Weather agent needs no key of its own -- it uses Open-Meteo, which is
# free with no signup.
